{
    "name": "@sass-pire/viewports",
    "version": "1.0.0",
    "description": "Viewports is a package of sass-pire packages to wrap all breakpoints you need for media queries.",
    "license": "MIT",
    "author": "Khaled Mohamed <k.mohamed.11.98@gmail.com> (https://github.com/krypton225)",
    "contributors": [
        "Khaled Mohamed"
    ],
    "bugs": {
        "url": "https://github.com/Black-Axis/sass-pire/issues",
        "email": "black_axis@outlook.com"
    },
    "keywords": [
        "scss",
        "sass",
        "sass-pire",
        "viewport",
        "sass-library",
        "scss-library"
    ],
    "exports": {
        ".": "./index.scss",
        "./scss": "./index.scss"
    },
    "files": [
        "index.scss",
        "LICENSE.md",
        "README.md"
    ],
    "sideEffects": [
        "*.css",
        "*.scss"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Black-Axis/sass-pire",
        "directory": "packages/viewport"
    },
    "scripts": {
        "dev": "concurrently --prefix-colors=\"cyan,yellow,green,magenta\" \"yarn sass:watch\" \"yarn sass:comp\"",
        "sass:watch": "sass ./index.scss:dist/index.compiled.css --watch",
        "sass:comp": "sass ./index.scss:dist/index.compiled.min.css --watch --style=compressed"
    }
}
