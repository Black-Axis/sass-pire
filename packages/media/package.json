{
    "name": "@sass-pire/media",
    "version": "1.0.0",
    "description": "Media is of one of package of sass-pire packages.",
    "license": "MIT",
    "author": "Khaled Mohamed <k.mohamed.11.98@gmail.com> (https://github.com/krypton225)",
    "contributors": [
        "Khaled Mohamed"
    ],
    "bugs": {
        "url": "https://github.com/Black-Axis/sass-pire/issues",
        "email": "black_axis@outlook.com"
    },
    "keywords": [
        "scss",
        "sass",
        "sass-pire",
        "media",
        "sass-library",
        "scss-library"
    ],
    "exports": {
        ".": "./index.scss",
        "./scss": "./index.scss",
        "./css": "./dist/index.css",
        "./css/min": "./dist/index.min.css"
    },
    "sideEffects": [
        "*.css",
        "*.scss"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Black-Axis/sass-pire",
        "directory": "packages/media"
    },
    "scripts": {
        "dev": "concurrently --prefix-colors=\"cyan,yellow,green,magenta\" \"yarn sass:watch\" \"yarn sass:comp\"",
        "sass:watch": "sass --load-path=../../node_modules ./index.scss:dist/index.compiled.css --watch",
        "sass:comp": "sass --load-path=../../node_modules ./index.scss:dist/index.compiled.min.css --watch --style=compressed"
    },
    "devDependencies": {
        "@sass-pire/handlers": "workspace:*",
        "@sass-pire/lists": "workspace:*"
    }
}
