{
    "name": "@sass-pire/lists",
    "version": "1.0.0",
    "description": "List utilities and configuration for the sass-pire design system.",
    "license": "MIT",
    "author": "Khaled Mohamed <k.mohamed.11.98@gmail.com> (https://github.com/krypton225)",
    "contributors": [
        "Khaled Mohamed"
    ],
    "bugs": {
        "url": "https://github.com/Black-Axis/sass-pire/issues",
        "email": "black_axis@outlook.com"
    },
    "keywords": [
        "scss",
        "sass",
        "sass-pire",
        "lists",
        "design-system",
        "sass-library",
        "scss-library"
    ],
    "exports": {
        ".": "./index.scss",
        "./scss": "./index.scss"
    },
    "sideEffects": [
        "*.css",
        "*.scss"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Black-Axis/sass-pire",
        "directory": "packages/lists"
    },
    "scripts": {
        "dev": "concurrently --prefix-lists=\"cyan,yellow,green,magenta\" \"yarn sass:watch\"",
        "sass:watch": "sass --load-path=../../node_modules ./index.scss:dist/index.compiled.css --watch"
    }
}
